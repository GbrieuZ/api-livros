# Credenciais da autenticação HTTP Basic
MEU_USUARIO=admin
MINHA_SENHA=admin

# Banco de dados
DATABASE_URL=sqlite:///./livros.db

# Redis
# Dentro do Docker/Podman Compose use o NOME DO SERVIÇO: redis
# Rodando tudo local (fora de container), troque para: localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
KAFKA_SERVER=kafka:9092